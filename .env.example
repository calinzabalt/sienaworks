# Site
# Local: http://localhost:3000
# Production: https://sienaworks.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form — Brevo SMTP (SMTP & API page in Brevo).
# Verify hello@sienaworks.com as a sender in Brevo before going live.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=
# BREVO_SMTP_PASS=
# CONTACT_FROM_EMAIL=hello@sienaworks.com
# CONTACT_TO_EMAIL=hello@sienaworks.com

# Optional fallback if SMTP is not set.
# CONTACT_WEBHOOK_URL=
