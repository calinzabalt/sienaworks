# Site
# Local: http://localhost:3000
# Production and canonical URL. Local pages still open on localhost.
NEXT_PUBLIC_SITE_URL=https://sienaworks.com

# Public Google Analytics measurement ID. The tag loads only after analytics consent.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-21EY3FFRM7

# Optional Google Ads conversion ID. Events are sent only after marketing consent.
# NEXT_PUBLIC_ADS_CONVERSION_ID=

# Contact form — Brevo SMTP (SMTP & API page in Brevo).
# Verify hello@sienaworks.com as a sender in Brevo before going live.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=
# BREVO_SMTP_PASS=
# CONTACT_FROM_EMAIL=hello@sienaworks.com
# Inbox for every form. A copy also goes to CONTACT_CC_EMAIL.
# CONTACT_TO_EMAIL=hello@sienaworks.com
# CONTACT_CC_EMAIL=calin.cozmax@gmail.com

# Optional fallback if SMTP is not set.
# CONTACT_WEBHOOK_URL=

# Reserved for a future scanner. This build never fetches submitted URLs.
# SCANNER_ENABLED=false
